# Parameters for this push-triggered measurement run.
# Read by .github/workflows/measure.yml as whitelisted KEY=VALUE lines.
#
# Backtest over the most recent complete archived season. This is the
# IN-SEASON path, which the pre-season harness never reaches — worth running
# on its own because the live app switches to it the moment FPL fills in
# strength_attack_* / strength_defence_*, which pre-season are all zero.
HARNESS=backtest
SEASON=2025-26
