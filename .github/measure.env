# Parameters for this push-triggered measurement run.
# Read by .github/workflows/measure.yml as whitelisted KEY=VALUE lines.
SWEEP=MASS_SWEEP
# 9.6 is the value preseasonClubStartMass ships on, included so the sweep
# says whether it is an optimum or an interior point somebody picked.
# The neighbours either side of it are what say whether the surface is flat
# there or merely sampled too coarsely to tell.
GRID=0,7.0,7.5,8.0,9.0,9.5,9.6,10.0,10.5,11.0
